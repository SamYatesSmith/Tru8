# ==============================================================================
# Tru8 Backend — Environment Variables
# Copy to .env and fill in values. All keys match backend/app/core/config.py.
# ==============================================================================

# ---------- Database ----------
# Local: postgresql+asyncpg://postgres:password@localhost:5433/tru8_dev
# Railway: postgresql+asyncpg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/tru8_dev
DATABASE_SSL=false

# ---------- Redis ----------
# Local: redis://localhost:6379/0
# Railway: redis://${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0

# ---------- Auth (Clerk) ----------
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER=your-clerk-domain.clerk.accounts.dev

# ---------- LLM Providers ----------
# Primary: Google AI Studio (Gemini)
GOOGLE_AI_API_KEY=
PRIMARY_LLM_PROVIDER=google
GOOGLE_LLM_MODEL=gemini-2.5-flash-lite

# Secondary: OpenAI (used for decomposition, analysis, relevance scoring)
OPENAI_API_KEY=

# ---------- Search APIs ----------
SERPER_API_KEY=
BRAVE_API_KEY=
SERP_API_KEY=

# ---------- Fact-Check ----------
GOOGLE_FACTCHECK_API_KEY=

# ---------- Government APIs (all optional — adapters skip if key missing) ----------
NOAA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
WEATHER_API_KEY=
COMPANIES_HOUSE_API_KEY=
FOOTBALL_DATA_API_KEY=
MARKETAUX_API_KEY=
GOVINFO_API_KEY=
CONGRESS_API_KEY=

# ---------- YouTube ----------
YOUTUBE_API_KEY=

# ---------- Payments (Stripe) ----------
# Generate products/prices with: bash scripts/stripe-setup.sh
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_DEVELOPER=
STRIPE_PRICE_ID_CREDIT_PACK_5=
STRIPE_PRICE_ID_CREDIT_PACK_20=
STRIPE_PRICE_ID_CREDIT_PACK_100=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@trueight.com
EMAIL_FROM_NAME=Tru8
FEEDBACK_EMAIL=

# ---------- Storage (S3 / MinIO, optional) ----------
S3_BUCKET=tru8-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ---------- Monitoring ----------
SENTRY_DSN=
POSTHOG_API_KEY=
OTLP_ENDPOINT=

# ---------- App ----------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ADMIN_EMAILS=[]
BETA_TESTER_EMAILS=[]
SUBSCRIPTIONS_ENABLED=false

# ---------- Feature Flags (defaults are fine — uncomment to override) ----------
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_FACTCHECK_API=true
# ENABLE_TEMPORAL_CONTEXT=true
# ENABLE_CLAIM_CLASSIFICATION=true
# ENABLE_LEGAL_SEARCH=true
# ENABLE_API_RETRIEVAL=true
# ENABLE_SEARCH_CLARITY=true
# ENABLE_SEMANTIC_SNIPPET_EXTRACTION=true
# ENABLE_RHETORICAL_CONTEXT=true
# ENABLE_ARTICLE_CLASSIFICATION=true
# ENABLE_QUERY_PLANNING=true
# ENABLE_LLM_RELEVANCE_SCORER=true
# ENABLE_GLOBAL_DOMAIN_CAPPING=true

# ---------- Manifest Signing (M-04) ----------
# Tamper-evidence signature attached to every completed check. Agents can
# verify integrity via GET /verify/{check_id} (public, no auth, 60/min).
# To enable:
#   1. Generate a 256-bit key:  openssl rand -base64 32
#   2. Set MANIFEST_SIGNING_KEY to the output
#   3. Flip MANIFEST_SIGNING_ENABLED to True
# Failure mode if enabled without key: _manifest is null + warn log (graceful).
# MANIFEST_SIGNING_KEYS is for rotation - leave empty until first rotation,
# then populate as JSON: {"old-kid": "old_b64_key"}.
MANIFEST_SIGNING_ENABLED=False
MANIFEST_SIGNING_KEY=
MANIFEST_KID=tru8-2026-03
MANIFEST_SIGNING_KEYS={}
