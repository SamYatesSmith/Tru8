# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY goes in .env.local (never committed)

# Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe Payments (publishable keys only — safe for .env)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Retired tiers (existing subscribers only)
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ID_DEVELOPER=
# Console GBP 20/mo + 200/yr (current lineup)
NEXT_PUBLIC_STRIPE_PRICE_ID_CONSOLE=
NEXT_PUBLIC_STRIPE_PRICE_ID_CONSOLE_ANNUAL=

# Features
NEXT_PUBLIC_ENABLE_DEEP_MODE=false
NEXT_PUBLIC_ENABLE_LIGHT_THEME=false

# Subscriptions — set to 'true' when Stripe products are configured
NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED=false

# Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
